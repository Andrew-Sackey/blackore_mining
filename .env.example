# Public site origin. Used for metadataBase, canonical URLs, the sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://blackoremining.com

# Formspree form id. Leave empty in development to simulate a successful enquiry.
NEXT_PUBLIC_FORMSPREE_FORM_ID=

# Cookieless Vercel Web Analytics and Speed Insights. Set to "on" to enable.
NEXT_PUBLIC_ANALYTICS=off

# Origin allowed to serve footage and images (for example a Vercel Blob store).
# Leave empty while media stays in /public. No trailing slash.
NEXT_PUBLIC_MEDIA_HOST=

# Feature flags are constants in src/content/site.ts, not environment variables:
# SHOW_PILLAR_DOWNLOAD, SHOW_SURVEY_PLAN (both false until the client approves),
# SHOW_TEAM (true). Change them there.
